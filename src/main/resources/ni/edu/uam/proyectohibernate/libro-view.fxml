<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="666.0" prefWidth="1000.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.proyectohibernate.controller.LibroController">

    <children>

        <!-- PANEL DEL FORMULARIO -->
        <AnchorPane layoutX="30.0" layoutY="74.0" prefHeight="219.0" prefWidth="940.0" style="-fx-background-color: white;                    -fx-background-radius: 12;                    -fx-border-radius: 12;                    -fx-border-color: #E2E8F0;">

            <children>

                <Label layoutX="25.0" layoutY="18.0" style="-fx-font-size: 18px;                            -fx-font-weight: bold;                            -fx-text-fill: #1E293B;" text="Información del libro" />

                <!-- TITULO -->
                <Label layoutX="25.0" layoutY="65.0" style="-fx-font-size: 13px;                            -fx-font-weight: bold;                            -fx-text-fill: #475569;" text="Título" />

                <TextField fx:id="txtTitulo" layoutX="25.0" layoutY="88.0" prefHeight="28.0" prefWidth="420.0" promptText="Ingrese el título del libro" style="-fx-background-color: #F8FAFC;                            -fx-border-color: #CBD5E1;                            -fx-border-radius: 6;                            -fx-background-radius: 6;" />

                <!-- AUTOR -->
                <Label layoutX="490.0" layoutY="65.0" style="-fx-font-size: 13px;                            -fx-font-weight: bold;                            -fx-text-fill: #475569;" text="Autor" />

                <TextField fx:id="txtAutor" layoutX="490.0" layoutY="88.0" prefHeight="28.0" prefWidth="420.0" promptText="Ingrese el nombre del autor" style="-fx-background-color: #F8FAFC;                            -fx-border-color: #CBD5E1;                            -fx-border-radius: 6;                            -fx-background-radius: 6;" />

                <!-- AÑO -->
                <Label layoutX="25.0" layoutY="145.0" style="-fx-font-size: 13px;                            -fx-font-weight: bold;                            -fx-text-fill: #475569;" text="Año de publicación" />

                <TextField fx:id="txtAnio" layoutX="25.0" layoutY="168.0" prefHeight="28.0" prefWidth="420.0" promptText="Ejemplo: 2024" style="-fx-background-color: #F8FAFC;                            -fx-border-color: #CBD5E1;                            -fx-border-radius: 6;                            -fx-background-radius: 6;" />

                <!-- PRECIO -->
                <Label layoutX="490.0" layoutY="145.0" style="-fx-font-size: 13px;                            -fx-font-weight: bold;                            -fx-text-fill: #475569;" text="Precio" />

                <TextField fx:id="txtPrecio" layoutX="490.0" layoutY="168.0" prefHeight="28.0" prefWidth="420.0" promptText="Ejemplo: 250.00" style="-fx-background-color: #F8FAFC;                            -fx-border-color: #CBD5E1;                            -fx-border-radius: 6;                            -fx-background-radius: 6;" />

            </children>
        </AnchorPane>

        <!-- BOTONES -->

        <Button fx:id="btnGuardar" layoutX="31.0" layoutY="319.0" onAction="#guardarLibro" prefHeight="28.0" prefWidth="155.0" style="-fx-background-color: #B8E6C8; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-background-radius: 7; -fx-cursor: hand;" text="Guardar libro" />

        <Button fx:id="btnModificar" layoutX="194.0" layoutY="319.0" onAction="#modificarLibro" prefHeight="28.0" prefWidth="155.0" style="-fx-background-color: #FFE3A3; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-background-radius: 7; -fx-cursor: hand;" text="Modificar libro" />

        <Button fx:id="btnEliminar" layoutX="357.0" layoutY="319.0" onAction="#eliminarLibro" prefHeight="28.0" prefWidth="155.0" style="-fx-background-color: #F7BFC5; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-background-radius: 7; -fx-cursor: hand;" text="Eliminar libro" />

        <Button fx:id="btnCargar" layoutX="522.0" layoutY="319.0" onAction="#cargarLibros" prefHeight="28.0" prefWidth="155.0" style="-fx-background-color: #BFDDF8; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-background-radius: 7; -fx-cursor: hand;" text="Cargar libros" />

        <Button fx:id="btnLimpiar" layoutX="686.0" layoutY="319.0" onAction="#limpiarCampos" prefHeight="28.0" prefWidth="155.0" style="-fx-background-color: #DCCCF4; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-background-radius: 7; -fx-cursor: hand;" text="Limpiar campos" />

        <!-- TABLA -->
        <TableView fx:id="tblLibros" layoutX="30.0" layoutY="402.0" prefHeight="254.0" prefWidth="940.0" style="-fx-background-color: white;                    -fx-border-color: #E2E8F0;                    -fx-border-radius: 8;">

            <columns>
                <TableColumn fx:id="colId" prefWidth="95.0" text="ID" />

                <TableColumn fx:id="colTitulo" prefWidth="260.0" text="Título" />

                <TableColumn fx:id="colAutor" prefWidth="250.0" text="Autor" />

                <TableColumn fx:id="colAnio" prefWidth="130.0" text="Año" />

                <TableColumn fx:id="colPrecio" prefWidth="200.0" text="Precio" />
            </columns>

        </TableView>
      <Label layoutX="40.0" layoutY="32.0" text="Gestión de libros - Hibernate ORM">
         <font>
            <Font name="Palatino Linotype Bold" size="24.0" />
         </font>
      </Label>
      <Label layoutX="27.0" layoutY="375.0" text="Seleccione un libro de la tabla para modificarlo o eliminarlo.">
         <font>
            <Font name="Palatino Linotype Bold" size="15.0" />
         </font>
      </Label>

    </children>

</AnchorPane>
